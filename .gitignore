.DS_Store
__pycache__/
*.pyc

# scratch files: batch site lists I scan then merge, retired scans, benchmark exports.
# the real scans live in data/scan-<date>.csv and should be committed; these should not.
data/new-*.csv
data/_retired_*.csv
data/*-canada10.csv
data/canada10-domains.txt
data/pqcmonitor-canada10.csv
data/scan_new.csv
data/sites_new.csv

# Derived reports. cdn_attribution.py and readiness_score.py each write a couple
# of CSVs beside the scan they were run against. They are regenerable from the
# committed scans in one command, so running either script should not leave the
# repository dirty.
data/attribution-*.csv
data/cdn-readiness-*.csv
data/stacked-bar-*.csv
data/readiness-*.csv

# the scan service runs in a venv, don't commit it
api/.venv/
_to_delete/
logs_scan_*.txt
